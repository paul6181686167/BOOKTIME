{
  "name": "booktime-frontend",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@heroicons/react": "^2.0.18",
    "@testing-library/jest-dom": "^5.16.4",
    "@testing-library/react": "^13.3.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "axios": "^1.6.0",
    "canvas-confetti": "^1.9.4",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.525.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.8.0",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "cross-env CI=false DISABLE_ESLINT_PLUGIN=true react-scripts build",
    "build:native": "cross-env CI=false REACT_APP_NATIVE_BUILD=true REACT_APP_BACKEND_URL=https://booktime-uo15.onrender.com REACT_APP_API_URL=https://booktime-uo15.onrender.com react-scripts build",
    "android:sync": "npm run build:native && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleRelease",
    "android:bundle": "npm run android:sync && cd android && gradlew.bat bundleRelease",
    "test": "react-scripts test",
    "test:pipelines": "react-scripts test \"--testPathPattern=(sourceMerge|seriesLibraryService|openLibraryBookDisplay|searchSourcePipeline)\" --watchAll=false",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "rules": {
      "no-unused-vars": "warn",
      "react-hooks/exhaustive-deps": "warn"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "autoprefixer": "^10.4.14",
    "cross-env": "^10.1.0",
    "postcss": "^8.4.24",
    "tailwindcss": "^3.3.2"
  },
  "proxy": "http://localhost:8001"
}
