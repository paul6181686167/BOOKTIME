{
  "name": "booktime",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo Booktime — le frontend Vercel se build depuis /frontend",
  "scripts": {
    "install:frontend": "npm ci --prefix frontend --include=dev",
