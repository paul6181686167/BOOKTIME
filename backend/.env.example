# BOOKTIME - Configuration Backend
# Copier ce fichier en .env et remplir les valeurs

# Mode MOCK : true = données en mémoire (pour test sans MongoDB)
# false = connexion MongoDB réelle
RAILWAY_MONGODB_MOCK=true

# MongoDB - Local ou Atlas
# Local : mongodb://localhost:27017/booktime
# Atlas : mongodb+srv://user:password@cluster.mongodb.net/?...
MONGO_URL=mongodb://localhost:27017/booktime

# JWT - Générer une clé forte : python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=REMPLACER_PAR_une_clé_secrète_longue_et_aléatoire

# CORS - Origines autorisées (séparées par des virgules)
CORS_ORIGINS=http://localhost:3000

# Google Books API (fortement recommandé pour les lots multi-sources ; sans clé = quota 429)
GOOGLE_BOOKS_API_KEY=

# Import dump Open Library (optionnel)
# OL_DUMP_IA_ITEM=ol_dump_2025-11-30
# OL_DUMP_BULK_SIZE=800
# OL_DUMP_WORKS_URL=
# OL_DUMP_EDITIONS_URL=

# Wikidata statique : fichiers wikidata_series_db.json / popular_standalone_books.json (chemins dans app/config.py). Routes /api/static-wikidata/* : JWT requis (comme Open Library).

# Fiches quotidiennes (Wikidata) : 25 séries complètes / jour par défaut.
# ENABLE_CATALOG_DAILY=false pour désactiver le cron 03:30 UTC.
# CATALOG_DAILY_SECRET : même valeur sur Render et dans le secret GitHub Actions
# pour POST /api/catalog/daily/run
# CATALOG_DAILY_SERIES=25
# CATALOG_DAILY_HOUR_UTC=3
# CATALOG_DAILY_MINUTE_UTC=30
ENABLE_CATALOG_DAILY=true
CATALOG_DAILY_SECRET=
